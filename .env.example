# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional API key for sending certificates and OTP emails via Resend.
RESEND_API_KEY=

# ADMIN_PASSCODE: Optional passcode for accessing the /admin management portal.
ADMIN_PASSCODE=
